{
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/panel.js": { "includeFiles": "panels/**" }
  },
  "rewrites": [
    { "source": "/api/auth/:action", "destination": "/api/auth?action=:action" },
    { "source": "/api/v1/:resource/:id", "destination": "/api/v1?resource=:resource&id=:id" },
    { "source": "/api/v1/:resource", "destination": "/api/v1?resource=:resource" },
    { "source": "/admin", "destination": "/api/panel?p=admin" },
    { "source": "/admin/:path*", "destination": "/api/panel?p=admin" },
    { "source": "/workers", "destination": "/api/panel?p=workers" },
    { "source": "/workers/:path*", "destination": "/api/panel?p=workers" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(admin|workers)(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
