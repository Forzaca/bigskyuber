# ─────────────────────────────────────────────────────────────
#  Big Sky Uber · environment variables
#  Copy to .env.local for `vercel dev`, and add each one in
#  Vercel → Project → Settings → Environment Variables.
#  Never commit the real values.
# ─────────────────────────────────────────────────────────────

# ── Discord sign-in (https://discord.com/developers/applications → OAuth2)
DISCORD_CLIENT_ID=123456789012345678
DISCORD_CLIENT_SECRET=replace-with-your-oauth2-client-secret
# Optional. Defaults to https://<your-domain>/api/auth/callback
# Whatever you use must also be added under OAuth2 → Redirects.
DISCORD_REDIRECT_URI=https://bigskyuber.vercel.app/api/auth/callback

# ── Panel access (the roles that unlock /admin and /workers)
# Your Discord server ID (right-click server → Copy Server ID, Developer Mode on).
DISCORD_GUILD_ID=111111111111111111
# Role that unlocks /admin (also gets /workers). Comma-separate for several roles.
DISCORD_ADMIN_ROLE_ID=222222222222222222
# Role that unlocks /workers. Comma-separate for several roles.
DISCORD_WORKER_ROLE_ID=333333333333333333
# Optional: user IDs that always get admin, even without the role (e.g. the owner).
ADMIN_DISCORD_IDS=444444444444444444
# Optional: user IDs that always get the worker panel.
WORKER_DISCORD_IDS=

# Optional but recommended: a bot token from a bot that is IN your server.
# With it, roles are re-checked every 10 minutes, so removing someone's role
# locks them out of the panels right away instead of when their session ends.
DISCORD_BOT_TOKEN=

# Optional: a channel webhook that gets pinged for new / accepted / completed rides.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/replace-me

# ── Sessions
# Any long random string (32+ characters). Changing it signs everyone out.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters

# ── Storage (Vercel → Storage → Create Blob store → connect to project)
# Vercel adds this automatically when you connect the store.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: private | public. Auto-detected if left empty. Private is recommended.
BLOB_ACCESS=private
# Optional: folder name your data lives under inside the store.
DATA_KEY=bigsky

# ── Discord bot API key
# Your bot sends this as:  Authorization: Bearer <value>   (or X-API-Key: <value>)
UBERBIGSKY=sdhfkhsdgehfbshvefydhsvsefBSRP

# ── ER:LC private server API (optional)
# In ER:LC: your private server → Settings → ER:LC API → copy the server key.
# Enables: live player count + join code on the site, "rider must be in the server"
# check on ride requests, In-server badges for drivers, and GET /api/v1/server.
ERLC_API_KEY=
